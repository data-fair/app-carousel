{
  "type": "object",
  "required": [
    "datasets"
  ],
  "allOf": [
    {
      "title": "Source de données",
      "properties": {
        "datasets": {
          "type": "array",
          "items": [
            {
              "type": "object",
              "title": "Jeu de données",
              "properties": {
                "href": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "schema": {
                  "type": "array"
                }
              },
              "layout": {
                "getItems": {
                  "url": "api/v1/datasets?status=finalized&q={q}&select=id,title,schema&${context.datasetFilter}&concepts=http://schema.org/image,http://schema.org/DigitalDocument&sort=createdAt:-1&size=100",
                  "itemKey": "data.href",
                  "itemTitle": "data.title",
                  "itemsResults": "data.results"
                }
              }
            }
          ]
        },
        "staticFilters": {
          "title": "Filtres prédéfinis",
          "type": "array",
          "items": {
            "type": "object",
            "discriminator": {
              "propertyName": "type"
            },
            "default": {
              "type": "in"
            },
            "oneOf": [
              {
                "title": "Restreindre à des valeurs",
                "additionalProperties": false,
                "required": [
                  "type",
                  "field",
                  "values"
                ],
                "properties": {
                  "type": {
                    "const": "in"
                  },
                  "field": {
                    "type": "object",
                    "title": "Colonne de filtre",
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/schema?calculated=false",
                        "itemKey": "data.key",
                        "itemTitle": "data.label"
                      }
                    },
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      }
                    }
                  },
                  "values": {
                    "type": "array",
                    "title": "Valeurs",
                    "items": {
                      "type": "string"
                    },
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/values/${parent.parent.data.field.key}?q={q}&q_mode=complete&size=100&stringify=true",
                        "itemKey": "data",
                        "itemTitle": "data"
                      }
                    }
                  }
                }
              },
              {
                "title": "Restreindre à un interval de valeurs",
                "additionalProperties": false,
                "required": [
                  "type",
                  "field"
                ],
                "properties": {
                  "type": {
                    "const": "interval"
                  },
                  "field": {
                    "type": "object",
                    "title": "Colonne de filtre",
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/schema?calculated=false",
                        "itemKey": "data.key",
                        "itemTitle": "data.label"
                      }
                    },
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      }
                    }
                  },
                  "minValue": {
                    "type": "string",
                    "title": "Valeur min",
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/values/${parent.parent.data.field.key}?q={q}&q_mode=complete&size=100&stringify=true",
                        "itemKey": "data",
                        "itemTitle": "data"
                      }
                    }
                  },
                  "maxValue": {
                    "type": "string",
                    "title": "Valeur max",
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/values/${parent.parent.data.field.key}?q={q}&q_mode=complete&size=100&stringify=true",
                        "itemKey": "data",
                        "itemTitle": "data"
                      }
                    }
                  }
                }
              },
              {
                "title": "Exclure des valeurs",
                "additionalProperties": false,
                "required": [
                  "type",
                  "field",
                  "values"
                ],
                "properties": {
                  "type": {
                    "const": "out"
                  },
                  "field": {
                    "type": "object",
                    "title": "Colonne de filtre",
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/schema?calculated=false",
                        "itemKey": "data.key",
                        "itemTitle": "data.label"
                      }
                    },
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      }
                    }
                  },
                  "values": {
                    "type": "array",
                    "title": "Valeurs à exclure",
                    "items": {
                      "type": "string"
                    },
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/values/${parent.parent.data.field.key}?q={q}&q_mode=complete&size=100&stringify=true",
                        "itemKey": "data",
                        "itemTitle": "data"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "title": "Présentation",
      "properties": {
        "interval": {
          "type": "integer",
          "title": "Durée d'affichage des images (sec)",
          "description": "Mettre à 0 pour désactiver la rotation automatique",
          "default": 6,
          "minimum": 0,
          "maximum": 30
        },
        "linksTarget": {
          "type": "string",
          "title": "Mode d'ouverture des liens",
          "default": "_top",
          "oneOf": [
            {
              "const": "_top",
              "title": "Dans le même onglet"
            },
            {
              "const": "_blank",
              "title": "Dans un nouvel onglet"
            }
          ]
        },
        "distactivateLinks": {
          "type": "boolean",
          "title": "Désactiver les liens",
          "description": "Un bouton 'en savoir plus' est automatiquement ajouté quand la source de données a une colonne avec le concept 'page web'. Cette option permet de le cacher.",
          "default": false
        },
        "hideTitle": {
          "type": "boolean",
          "title": "Cacher les titres",
          "description": "Un texte sur fond sombre est automatiquement ajouté quand la source de données a une colonne avec le concept 'libellé'. Cette option permet de le cacher.",
          "default": false
        }
      }
    }
  ],
