{
  "name": "@data-fair/app-carousel",
  "version": "1.0.2",
  "description": "Application de diaporama déroulant pour DataFair",
  "type": "module",
  "files": [
    "/dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "dev": "df-dev-env && dotenv -- zellij --layout .zellij.kdl",
    "dev-server": "df-dev-server",
    "dev-app": "vite",
    "build": "npm run build-types && PUBLIC_URL=https://cdn.jsdelivr.net/npm/@data-fair/app-carousel@${npm_package_version}/dist vite build",
    "build-preview": "npm run build-types && vite build",
    "build-types": "df-build-types src/config",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepare": "husky || true",
    "type-check": "vue-tsc --noEmit",
    "test": "df-dev-env && dotenv -- playwright test --max-failures=1",
    "test-unit": "playwright test --project=unit",
    "test-e2e": "df-dev-env && dotenv -- playwright test --project=e2e",
    "quality": "npm run lint && npm run build-types && npm run type-check && npm run build && npm test && npm audit --omit=dev --audit-level=critical"
  },
  "dependencies": {
    "@data-fair/lib-utils": "^1.15.0",
    "@data-fair/lib-vue": "^1.33.0",
    "@data-fair/lib-vuetify": "^2.5.5",
    "@mdi/js": "^7.4.47",
    "@vueuse/core": "^14.4.0",
    "dayjs": "^1.11.20",
    "ofetch": "^1.5.1",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vuetify": "^4.3.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@data-fair/dev-server": "^2.7.0",
    "@data-fair/lib-common-types": "^1.28.1",
    "@data-fair/lib-types-builder": "^1.14.6",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@json-layout/core": "^2.14.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^25.9.9",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.2.0",
    "eslint-plugin-vuetify": "^2.7.3",
    "husky": "^9.1.7",
    "neostandard": "^0.13.0",
    "sass-embedded": "^1.108.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.2.7"
  }
}
